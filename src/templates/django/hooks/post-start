#!/usr/bin/env bash

set -e
source "${DIP_DIR}/commands/utils/color.sh"

msg "${YELLOW}[INFO] Waiting for Django to start...${NOFORMAT}"

RETRIES=30
until dip exec app "wget -q -O- http://127.0.0.1:8000" >/dev/null 2>&1; do
  RETRIES=$((RETRIES - 1))
  if [ $RETRIES -eq 0 ]; then
    msg "${RED}[ERROR] App failed to start after 60s${NOFORMAT}"
    msg "${YELLOW}[HINT] Check logs: dip run logs${NOFORMAT}"
    exit 1
  fi
  sleep 2
done

msg "${GREEN}[OK] App is up → https://${DOMAIN}${NOFORMAT}"
